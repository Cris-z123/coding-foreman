# ============================================================
# 项目环境变量模板
#
# 用法：复制本文件为 .env，然后填入自己的真实密钥。
#       .env 已在 .gitignore 中忽略，不会被提交。
#
# 加载规则（agent/src/utils/env_utils.py）：
#   - 空值变量不会被写入环境变量，所以没用到的字段保持空白即可；
#   - 只有 .env 中填了非空值才会覆盖系统环境变量。
# ============================================================

# ---------- DeepSeek 主模型（必填，后端启动即校验）----------
# DEEPSEEK_API_KEY 与 DEEPSEEK_BASE_URL 缺失会在调用模型时直接报错。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# 主模型名称，默认 deepseek-v4-pro
MAIN_MODEL=deepseek-v4-pro
# 意图分类模型（可选）：用于把用户输入归类为固定任务类型，
# 默认回退到 MAIN_MODEL；temperature 默认 0，max_tokens 默认 200。
# INTENT_MODEL=
# INTENT_MODEL_TEMPERATURE=0
# INTENT_MODEL_MAX_TOKENS=200

# ---------- 智谱 Web Search（web_search 工具需要，可选）----------
# 只有用到联网搜索工具时才必填，后端启动阶段不会校验。
ZHIPU_API_KEY=

# ---------- Gitee ----------
# 用于 clone / push / 创建 PR / 读取 PR 评论。
GITEE_TOKEN=
GITEE_API_BASE_URL=https://gitee.com/api/v5
# 部分工具会回退读取该变量，填同一个 Token 即可
SCM_GITEE_TOKEN=

# ---------- Agent 工作区（重要）----------
# Agent 实际操作代码仓库的目录，必须和本项目的源码目录分离，
# 否则 Agent 执行任务时可能误改 FOREMAN 项目本身。
# 注意：代码里的默认值是 E:\ai_workspace，换机器后务必显式覆盖。
AI_WORKSPACE_ROOT=D:\ai_workspace

# ---------- 数据与日志目录（可选，留空用默认值）----------
# 默认分别是项目下的 data/ 与 logs/
# FOREMAN_DATA_DIR=
# FOREMAN_LOG_DIR=
# CHECKPOINT_DB_PATH=
# STORE_DB_PATH=
# LANGGRAPH_STORE_DB_PATH=

# ---------- 日志配置（可选）----------
# FOREMAN_LOG_LEVEL=INFO
# FOREMAN_LOG_WHEN=midnight
# FOREMAN_LOG_INTERVAL=1
# FOREMAN_LOG_RETENTION_DAYS=14

# ---------- 运行保护（可选）----------
# 限制单轮任务的最大工具调用次数与最长时间，防止 Agent 死循环。
# AGENT_MAX_TOOL_CALLS=
# AGENT_MAX_SECONDS=

# ---------- 服务端口（可选，仅 shell 启动脚本读取）----------
# FOREMAN_BACKEND_HOST=127.0.0.1
# FOREMAN_BACKEND_PORT=2024
# FOREMAN_UI_HOST=127.0.0.1
# FOREMAN_UI_PORT=3000
